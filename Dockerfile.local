FROM eclipse-temurin:21-alpine
LABEL maintainer="David Jaiyeola<david.jaiyeola@gmail.com>"
# Add the service itself
#ARG JAR_FILE
ADD target/TradeExecutionAggregationService-0.0.1-SNAPSHOT.jar /usr/share/app/TradeExecutionAggregationService-0.0.1-SNAPSHOT.jar
ENV JAVA_OPTS=""
ENTRYPOINT [ "sh", "-c", "java $JAVA_OPTS -Djava.security.egd=file:/dev/./urandom -jar /usr/share/app/TradeExecutionAggregationService-0.0.1-SNAPSHOT.jar" ]


